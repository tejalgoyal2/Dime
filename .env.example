# Supabase (required at build time for client bundle)
# Also add as GitHub Secrets for CI: NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key (sb_publishable_...). The name is historical.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key

# AI (server-only, set in Cloudflare Worker secrets). Gemini answers first;
# Groq is the optional backup.
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key
# Optional overrides. By default Gemini uses Google's -latest aliases
# (gemini-flash-lite-latest, gemini-flash-latest) and Groq openai/gpt-oss-120b.
# GEMINI_MODEL=
# GROQ_MODEL=

# App config (server-only, set in Cloudflare Worker secrets)
INVITE_CODE=your-invite-code

# Upstash Redis — rate limiting (server-only, set in Cloudflare Worker secrets)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Quick Add API — Apple Shortcuts / automation (server-only)
QUICK_ADD_TOKEN=your-secret-bearer-token
QUICK_ADD_USER_ID=your-supabase-user-uuid

# GitHub Actions Secrets (not in .env, add to repo settings):
# CLOUDFLARE_API_TOKEN — Cloudflare API token with "Edit Cloudflare Workers" permission
# CLOUDFLARE_ACCOUNT_ID — Your Cloudflare account ID

# Auto-log (/api/ingest) and the keep-alive workflow. Server-only; set as a
# Cloudflare secret (npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY) and a
# GitHub secret. Never prefix with NEXT_PUBLIC_.
# Use a secret key (sb_secret_...). The name is historical.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your-key
